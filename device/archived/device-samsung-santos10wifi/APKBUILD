# Archived: unmaintained
# Reference: <https://postmarketos.org/devicepkg>
maintainer=""
pkgname=device-samsung-santos10wifi
pkgdesc="Samsung Galaxy Tab 3 10.1 Wi-Fi"
pkgver=4
pkgrel=4
url="https://postmarketos.org"
license="MIT"
arch="x86"
options="!check !archcheck"
triggers="$pkgname.trigger=/usr/sbin:/usr/lib/ssh:/etc"
depends="postmarketos-base linux-samsung-santos10wifi mkbootimg"
makedepends="devicepkg-dev"
subpackages="
	$pkgname-x11
	$pkgname-nonfree-firmware:nonfree_firmware
"

source="deviceinfo
	xorg.conf
	10-losetup-no-direct-io.sh
	71-lightdm-santos10wifi.conf"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir"/10-losetup-no-direct-io.sh \
		-t "$pkgdir"/usr/share/mkinitfs/hooks/
}

x11() {
	install_if="$pkgname xorg-server"
	depends="
		xf86-input-libinput
		xf86-video-fbdev"
	install -Dm644 "$srcdir"/xorg.conf \
		"$subpkgdir"/usr/share/X11/xorg.conf.d/10-santos10wifi.conf
	install -Dm644 "$srcdir"/71-lightdm-santos10wifi.conf \
		-t "$subpkgdir"/usr/share/lightdm/lightdm.conf.d/
}

nonfree_firmware() {
	pkgdesc="Wi-Fi firmware"
	depends="firmware-samsung-santos10wifi"
	mkdir "$subpkgdir"
}

