+#ifdef CONFIG_SHMEM
+/*
+ * Backport of memfd_create() (Linux 3.17) for the vendor 3.4 kernel.
+ * Userspace (glibc/musl, glycin, Wayland, ...) needs it. Seals are recorded
+ * and reported by fcntl(F_ADD_SEALS/F_GET_SEALS) but not enforced.
+ */
+#define MFD_CLOEXEC		0x0001U
+#define MFD_ALLOW_SEALING	0x0002U
+#define MFD_NAME_PREFIX		"memfd:"
+#define MFD_NAME_PREFIX_LEN	(sizeof(MFD_NAME_PREFIX) - 1)
+#define MFD_NAME_MAX_LEN	(NAME_MAX - MFD_NAME_PREFIX_LEN)
+
+long shmem_fcntl(struct file *file, unsigned int cmd, unsigned long arg)
+{
+	struct shmem_inode_info *info;
+
+	if (file->f_op != &shmem_file_operations)
+		return -EINVAL;
+	info = SHMEM_I(file->f_path.dentry->d_inode);
+
+	switch (cmd) {
+	case F_GET_SEALS:
+		return info->seals;
+	case F_ADD_SEALS:
+		if (!(file->f_mode & FMODE_WRITE))
+			return -EPERM;
+		if (arg & ~(F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE))
+			return -EINVAL;
+		if (info->seals & F_SEAL_SEAL)
+			return -EPERM;
+		info->seals |= arg;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+SYSCALL_DEFINE2(memfd_create, const char __user *, uname, unsigned int, flags)
+{
+	struct shmem_inode_info *info;
+	struct file *file;
+	int fd, error;
+	char *name;
+	long len;
+
+	if (flags & ~(MFD_CLOEXEC | MFD_ALLOW_SEALING))
+		return -EINVAL;
+
+	len = strnlen_user(uname, MFD_NAME_MAX_LEN + 1);
+	if (len <= 0)
+		return -EFAULT;
+	if (len > MFD_NAME_MAX_LEN + 1)
+		return -EINVAL;
+
+	name = kmalloc(len + MFD_NAME_PREFIX_LEN, GFP_KERNEL);
+	if (!name)
+		return -ENOMEM;
+
+	strcpy(name, MFD_NAME_PREFIX);
+	if (copy_from_user(&name[MFD_NAME_PREFIX_LEN], uname, len)) {
+		error = -EFAULT;
+		goto err_name;
+	}
+	/* terminating NUL is included in len; make sure of it */
+	name[len + MFD_NAME_PREFIX_LEN - 1] = '\0';
+
+	fd = get_unused_fd_flags((flags & MFD_CLOEXEC) ? O_CLOEXEC : 0);
+	if (fd < 0) {
+		error = fd;
+		goto err_name;
+	}
+
+	file = shmem_file_setup(name, 0, VM_NORESERVE);
+	if (IS_ERR(file)) {
+		error = PTR_ERR(file);
+		goto err_fd;
+	}
+	info = SHMEM_I(file->f_path.dentry->d_inode);
+	file->f_mode |= FMODE_LSEEK | FMODE_PREAD | FMODE_PWRITE;
+	file->f_flags |= O_RDWR | O_LARGEFILE;
+	if (!(flags & MFD_ALLOW_SEALING))
+		info->seals = F_SEAL_SEAL;
+
+	fd_install(fd, file);
+	kfree(name);
+	return fd;
+
+err_fd:
+	put_unused_fd(fd);
+err_name:
+	kfree(name);
+	return error;
+}
+#endif /* CONFIG_SHMEM */
